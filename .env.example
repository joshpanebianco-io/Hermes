# NewsTerminal environment. Copy to `.env.local` (git-ignored) to change any of
# it. NOTHING HERE IS REQUIRED — every value below has a working default and
# the terminal runs on an empty environment.

# ---------------------------------------------------------------------------
# WEB -> COLLECTOR
# ---------------------------------------------------------------------------
# Where the Next server finds the collector. Read ONLY on the server: the
# route handler at /api/terminal proxies it, so the browser never learns the
# collector's address. Not prefixed NEXT_PUBLIC_, and it must never be.
NT_API=http://127.0.0.1:8100

# How often the browser re-polls the proxy, in seconds. The collector's own
# cadences are set below and are what actually determine freshness; this only
# controls how quickly the screen catches up with it.
NEXT_PUBLIC_POLL_SEC=20

# ---------------------------------------------------------------------------
# COLLECTOR -> GEXYGEN   (the gamma levels)
# ---------------------------------------------------------------------------
# The sister project's compute service. It already publishes exactly the seven
# levels this terminal shows (three call walls, three put walls, the flip) at
# /api/levels.txt, so they are read rather than recomputed — two engines would
# eventually disagree and then there are two call walls and no way to pick.
# Set to the empty string to disable the gamma panel entirely.
NT_GEXYGEN_API=http://127.0.0.1:8000
NT_GEX_ASSETS=NQ,ES,GC

# ---------------------------------------------------------------------------
# COLLECTOR — cadence, seconds
# ---------------------------------------------------------------------------
# Matched to each source's own clock rather than set to one number: quotes move
# continuously, a publisher's RSS regenerates every few minutes at best, and
# the Treasury curve is a once-a-day print.
# NT_QUOTES_SEC=20
# NT_WIRE_SEC=120
# NT_GEX_SEC=30
# NT_CALENDAR_SEC=600
# NT_RATES_SEC=1800

# NT_HOST=127.0.0.1
# NT_PORT=8100
# NT_CACHE=./cache
# NT_TICK_LOG=1

# ---------------------------------------------------------------------------
# OPTIONAL KEYS — absent is first-class
# ---------------------------------------------------------------------------
# Both are free and neither is needed. The panels that would use them say they
# are dormant rather than rendering an empty box.
#   FRED   https://fredaccount.stlouisfed.org/apikeys  — every economic series
#   EIA    https://www.eia.gov/opendata/register.php   — oil and gas inventories
# FRED_API_KEY=
# EIA_API_KEY=

# ---------------------------------------------------------------------------
# LICENSING — deliberately different from GEXYGEN
# ---------------------------------------------------------------------------
# THIS IS A PERSONAL, SINGLE-DESK TERMINAL AND IS NOT FIT TO SHIP.
#
# GEXYGEN is constrained to public-domain and openly-licensed sources because
# it goes commercial. This one is not: it reads Yahoo Finance quotes and full
# publisher RSS including summaries, both of which are permitted for personal
# use and neither of which may be redistributed. If any of this is ever put in
# front of another user or a paying one, the quote feed and the wire both have
# to be re-sourced first. Nothing else here changes.

# ---------------------------------------------------------------------------
# SESSION REPORT   (the Report tab — a model reads the terminal, calls a bias)
# ---------------------------------------------------------------------------
# REQUIRED FOR THE REPORT TAB AND FOR NOTHING ELSE. Every other panel works
# without it. There is deliberately no local fallback: the owner chose to have
# the model form the view rather than narrate a deterministic one, so with no
# key there is no report — an invented bias rendered in the same frame as a
# real one is the one failure this terminal must not have.
#
# Free, no card: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Which model writes it. The default is free and is one of the few free models
# that supports `structured_outputs`, which the report schema depends on — swap
# it for a paid model and the note gets noticeably better.
#
# Free-tier limits are 50 requests/day, or 1000/day once $10 of credit has ever
# been bought. A report is one request, so that is not a constraint in practice.
# NT_REPORT_MODEL=nvidia/nemotron-3.5-super-vl:free

{
  "name": "hermes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p 3100 -H 127.0.0.1",
    "prod": "set NT_DIST=.next-prod&& next build && next start -p 3100 -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "py:lint": "node scripts/py.mjs ruff check .",
    "py:types": "node scripts/py.mjs mypy",
    "icon": "node scripts/make-icon.mjs",
    "logos": "node scripts/fetch-logos.mjs",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1",
    "shortcut:collector": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1 -Collector",
    "check": "npm run typecheck && npm run lint && npm run py:lint && npm run py:types && npm run py:test",
    "py:test": "node scripts/py.mjs pytest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3"
  }
}
